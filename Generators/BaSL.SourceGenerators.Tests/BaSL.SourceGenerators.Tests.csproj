<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit.v3" Version="4.0.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
        <PackageReference Include="NETStandard.Library.Ref" Version="2.1.0" GeneratePathProperty="true" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../BaSL/BaSL.csproj" />
        <ProjectReference Include="../BaSL.SourceGenerators/BaSL.SourceGenerators.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="netstandard" HintPath="$(PkgNETStandard_Library_Ref)/ref/netstandard2.1/netstandard.dll" Aliases="netstandard" />
    </ItemGroup>

    <Target Name="Sus" AfterTargets="Build">
        <Warning Text="$(PkgNETStandard_Library_Ref)" />
    </Target>

</Project>